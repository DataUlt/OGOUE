# =====================================================
#  OGOUE - Configuration du backend
#
#  Copiez ce fichier vers backend\.env puis renseignez les valeurs :
#      Copy-Item backend\.env.example backend\.env
#
#  ATTENTION : backend\.env contient des secrets et ne doit JAMAIS
#  etre commite. Il est deja ignore par backend\.gitignore.
# =====================================================

# --- Serveur ---------------------------------------------------------
PORT=3001
NODE_ENV=development

# Secret de signature des JWT.
# En local, n'importe quelle chaine longue et aleatoire convient :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REMPLACER_PAR_UNE_CHAINE_ALEATOIRE

# --- URLs ------------------------------------------------------------
# Origines autorisees a appeler l'API (separees par des virgules).
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:8080,http://127.0.0.1:8080

# Base des liens envoyes par email (reinitialisation de mot de passe).
# En local, doit correspondre au port du serveur frontend : 8080.
# En production (Render), mettre : https://www.ogoue.com
FRONTEND_URL=http://localhost:8080

# --- Supabase : base principale (PFE-OGOUE) --------------------------
# Dashboard Supabase > Project Settings > API
SUPABASE_URL=https://mqbenehogdrmywhbxjhz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REMPLACER_PAR_LA_CLE_SERVICE_ROLE

# --- Supabase : base secondaire (PFE-OGOUE-FINANCEMENT) --------------
SUPABASE_URL_SECONDARY=https://zfzjvjpzszayrwsnblao.supabase.co
SUPABASE_SERVICE_ROLE_KEY_SECONDARY=REMPLACER_PAR_LA_CLE_SERVICE_ROLE_SECONDAIRE
